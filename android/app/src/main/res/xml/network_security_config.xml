<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit hardening: no cleartext anywhere, trust only the system CA store
     (user-installed CAs can't MITM traffic to AI providers or ad networks). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
