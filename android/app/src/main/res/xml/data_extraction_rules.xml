<?xml version="1.0" encoding="utf-8"?>
<!-- Keep Keystore-bound ciphertext and the private vault out of cloud backup
     and device-to-device transfer (see backup_rules.xml for rationale). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fsd_secure_keys.xml" />
        <exclude domain="sharedpref" path="fsd_cloud_backup_key.xml" />
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="datastore/fsd_pro.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fsd_secure_keys.xml" />
        <exclude domain="sharedpref" path="fsd_cloud_backup_key.xml" />
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="datastore/fsd_pro.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
