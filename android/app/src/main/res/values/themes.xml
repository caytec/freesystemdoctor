<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight-aware window background: a hardcoded black here flashes dark
         for a frame when the app starts in the light theme. -->
    <style name="Theme.FreeAndroidDoctor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.FreeAndroidDoctor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FreeAndroidDoctor</item>
    </style>
</resources>
